<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape>
            <size android:height="1.5dp" />
            <solid android:color="#4DFFFFFF" /> <corners android:radius="1dp" />
        </shape>
    </item>

    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape>
                <size android:height="4dp" />
                <solid android:color="#FFFFFF" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>